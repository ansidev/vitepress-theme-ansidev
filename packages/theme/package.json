{
  "name": "@ansidev-oss/vitepress-theme-ansidev",
  "version": "1.1.0",
  "description": "The VitePress theme for ansidev's blog",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "types/index.d.ts",
  "license": "MIT",
  "author": "Le Minh Tri <ansidev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansidev/vitepress-theme-ansidev.git"
  },
  "keywords": [
    "vitepress",
    "theme",
    "blog",
    "tailwindcss",
    "vue3",
    "typescript",
    "i18n",
    "dark-mode",
    "ansidev"
  ],
  "exports": {
    ".": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./styles.css": {
      "import": "./dist/client/styles.css",
      "types": "./styles.d.ts"
    },
    "./config": {
      "import": "./dist/node/config.mjs",
      "types": "./dist/node/config.d.ts"
    },
    "./composables": {
      "import": "./dist/node/composables.mjs",
      "types": "./dist/node/composables.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint:check": "biome check",
    "lint": "biome check --write",
    "dev:client": "vp build --watch",
    "dev:node": "vp pack --watch",
    "dev": "concurrently --kill-others \"pnpm dev:client\" \"pnpm dev:node\"",
    "clean": "rimraf dist",
    "build:client": "vp build && tsc --emitDeclarationOnly",
    "build:node": "vp pack",
    "build": "pnpm clean && concurrently \"pnpm build:client\" \"pnpm build:node\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@vueuse/core": "^15.0.0",
    "markdown-it": "^15.0.3",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.0",
    "glob": "^14.0.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^21.0.4",
    "medium-zoom": "^1.1.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.3",
    "swetrix": "^4.1.0",
    "tailwindcss": "^4.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "vite": "catalog:",
    "vitepress": "^2.0.0-alpha.16",
    "vue": "^3.5.28",
    "vue-tsc": "^3.2.5",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "glob": "^13.0.6 || ^14.0.0",
    "gray-matter": "^4.0.3",
    "medium-zoom": "^1.1.0",
    "swetrix": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.16",
    "vue": "^3.5.28"
  },
  "engines": {
    "node": ">=26.2.0",
    "pnpm": ">=11.3.0"
  }
}
