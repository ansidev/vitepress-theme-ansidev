{
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.vue",
      "**/*.ts",
      "**/*.mjs",
      "**/*.json",
      "!**/dist",
      "!**/.vitepress/cache",
      "!**/.vitepress/.temp"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/theme/src/client/components/Footer.vue",
        "packages/theme/src/client/components/Link.vue",
        "packages/theme/src/client/layouts/Layout.vue",
        "packages/theme/src/client/pages/Page.vue",
        "packages/theme/src/client/plugins/donation/components/Donation.vue",
        "packages/theme/src/client/plugins/sharing/components/Sharing.vue",
        "packages/theme/src/client/plugins/swetrix/components/Swetrix.vue"
      ],
      "linter": {
        "rules": {
          "style": {
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
