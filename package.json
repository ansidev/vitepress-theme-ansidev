{
  "name": "vitepress-theme-ansidev",
  "version": "1.2.0",
  "private": true,
  "description": "The VitePress theme for ansidev's blog",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm theme:build && (pnpm theme:dev & pnpm demo:dev & wait)",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r typecheck && pnpm vp check",
    "ci:lint": "pnpm theme:build && pnpm -r typecheck && pnpm vp check",
    "lint:fix": "pnpm vp check --fix",
    "theme:dev": "pnpm --filter @ansidev-oss/vitepress-theme-ansidev dev",
    "theme:build": "pnpm --filter @ansidev-oss/vitepress-theme-ansidev build",
    "demo:dev": "pnpm --filter @ansidev-oss/vitepress-theme-ansidev-demo dev",
    "demo:build": "pnpm --filter @ansidev-oss/vitepress-theme-ansidev-demo build",
    "demo:preview": "pnpm --filter @ansidev-oss/vitepress-theme-ansidev-demo preview",
    "prepare": "vp config"
  },
  "keywords": [
    "vitepress",
    "theme",
    "blog",
    "tailwindcss",
    "vue3",
    "typescript",
    "i18n",
    "dark-mode",
    "ansidev"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.2.0",
    "pnpm": ">=11.3.0"
  }
}
